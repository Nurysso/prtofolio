<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch color theme">
  <span class="dim" aria-hidden="true">[</span><span data-theme-label>dark</span><span class="dim" aria-hidden="true">]</span>
</button>

<script>
  const root = document.documentElement;
  const prefersLight = matchMedia('(prefers-color-scheme: light)');
  const button = document.querySelector('[data-theme-toggle]');
  const label = button.querySelector('[data-theme-label]');

  const current = () => root.dataset.theme || (prefersLight.matches ? 'light' : 'dark');

  const render = () => {
    const theme = current();
    label.textContent = theme;
    button.setAttribute('aria-label', `Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`);
  };

  button.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    render();
  });

  prefersLight.addEventListener('change', render);
  render();
</script>

<style>
  .theme-toggle {
    min-height: 44px;
    padding-inline: var(--s-1);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--fg-muted);
    transition: color var(--dur) var(--ease);
  }

  .theme-toggle:hover {
    color: var(--fg);
  }

  .dim {
    color: var(--fg-subtle);
  }
</style>

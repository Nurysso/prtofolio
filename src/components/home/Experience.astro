---
import HomeSection from './HomeSection.astro';
import { experience } from '../../data/profile.js';
import { inline, shortHash } from '../../lib/format.js';

// Drawn as `git log --graph`: newest first, with HEAD on the role I am in now
const jobs = experience.map((job) => ({
  ...job,
  hash: shortHash(`${job.company}|${job.role}|${job.period}`),
  current: /present/i.test(job.period),
}));
---

<HomeSection id="experience" path="experience">
  <Fragment slot="title">Work <span class="hl">history</span></Fragment>

  <ol class="log">
    {
      jobs.map((job) => (
        <li class:list={['commit', { 'is-head': job.current }]} data-reveal>
          <span class="node" aria-hidden="true" />
          <article class="job h-card">
            <header class="top">
              <div class="refs">
                <code class="hash">
                  <span class="dim">commit</span> {job.hash}
                </code>
                {job.current && <span class="ref">HEAD → main</span>}
              </div>
              <p class="when">
                {job.period}
                <span aria-hidden="true"> · </span>
                {job.location}
              </p>
            </header>

            <div>
              <h3 class="role">{job.role}</h3>
              <p class="company">
                {job.redact ? <span class="redact">{job.company}</span> : job.company}
                {job.note && <span class="h-tag">{job.note}</span>}
              </p>
            </div>

            <div class="body">
              <ul class="h-points">
                {job.bullets.map((b) => (
                  <li set:html={inline(b)} />
                ))}
              </ul>
              <div class="aside">
                {
                  job.lesson && (
                    <p class="lesson">
                      <span class="label">Lesson</span>
                      {job.lesson}
                    </p>
                  )
                }
                <ul class="h-tags">
                  {job.tags.map((t) => (
                    <li class="h-tag">{t}</li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        </li>
      ))
    }
  </ol>
</HomeSection>

<style>
  .log {
    --gap: clamp(18px, 2.6vw, 28px);
    display: grid;
    gap: var(--gap);
    list-style: none;
    padding: 0;
  }

  /* The rail: from this commit's node down to the next one */
  .commit {
    position: relative;
    padding-left: clamp(40px, 6vw, 72px);
  }

  .commit::before {
    content: '';
    position: absolute;
    left: 13px;
    top: 30px;
    bottom: calc(-1 * (var(--gap) + 30px));
    width: 2px;
    border-radius: 2px;
    background: var(--line-strong);
  }

  .commit:last-child::before {
    display: none;
  }

  .node {
    position: absolute;
    left: 5px;
    top: 21px;
    z-index: 1;
    width: 18px;
    height: 18px;
    border: 2px solid var(--line-strong);
    border-radius: 50%;
    background: var(--bg);
  }

  .is-head .node {
    border-color: var(--accent);
    background: var(--accent);
  }

  /* ─── The commit card ─── */
  .job {
    display: grid;
    gap: 22px;
    padding: clamp(20px, 3vw, 36px);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 18px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--fg-subtle);
  }

  .refs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .hash {
    color: var(--fg-muted);
  }

  .dim {
    color: var(--fg-subtle);
  }

  /* Marks the role I am in now, like the ref decoration in `git log` */
  .ref {
    padding: 1px 11px;
    border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 13%, transparent);
    color: var(--accent-text);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .role {
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 1.1rem + 1.1vw, 2.1rem);
    font-weight: 650;
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .company {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
    font-size: 1.0625rem;
    color: var(--fg-muted);
  }

  /* The company is under NDA, so its name is blacked out. The text stays in the DOM for screen readers. */
  .redact {
    padding: 0 0.45em;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    background: var(--redact);
    color: transparent;
    user-select: none;
  }

  .body {
    display: grid;
    gap: 28px;
  }

  @media (min-width: 960px) {
    .body {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      gap: 44px;
    }
  }

  .aside {
    display: grid;
    gap: 22px;
    align-content: start;
  }

  .lesson {
    padding: 4px 0 4px 18px;
    border-left: 2px solid var(--accent);
    font-family: var(--font-display);
    font-size: 1.1875rem;
    line-height: 1.35;
    color: var(--fg);
  }

  .lesson .label {
    display: block;
    margin-bottom: 8px;
    color: var(--accent-text);
  }
</style>

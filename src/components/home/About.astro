---
import HomeSection from './HomeSection.astro';
import { about, workingWithMe, skillTiers } from '../../data/profile.js';

// The first paragraph leads. The last one is the sign-off, so it gets a quote treatment of its own.
const [lead, ...rest] = about;
const signoff = rest.length > 1 ? rest.at(-1) : null;
const body = signoff ? rest.slice(0, -1) : rest;
---

<HomeSection id="about" path="about">
  <Fragment slot="title">About <span class="hl">me</span></Fragment>

  <div class="about">
    <div class="story" data-reveal>
      <p class="lead">{lead}</p>
      {body.map((paragraph) => <p class="body">{paragraph}</p>)}
      {signoff && <p class="signoff">{signoff}</p>}
    </div>

    <div class="tools h-card" data-reveal style="--i:1">
      <h3 class="label">Tools &amp; languages</h3>
      <dl class="tiers">
        {
          skillTiers.map((tier, level) => (
            <div class="tier" data-level={level}>
              <dt>{tier.label}</dt>
              <dd>
                <ul class="h-tags">
                  {tier.items.map((item) => (
                    <li class="h-tag">{item}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <div class="habits">
    <h3 class="label" data-reveal>Working with me</h3>
    <ol class="habit-grid">
      {
        workingWithMe.map((line, i) => (
          <li class="habit h-card" data-spot data-reveal style={`--i:${i}`}>
            <span class="n" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p>{line}</p>
          </li>
        ))
      }
    </ol>
  </div>
</HomeSection>

<style>
  .about {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }

  @media (min-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    }
  }

  .story {
    display: grid;
    gap: 22px;
    max-width: 46rem;
  }

  .lead {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.05rem + 0.9vw, 1.75rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--fg);
  }

  .body {
    max-width: 34rem;
    font-size: 1.0625rem;
    color: var(--fg-muted);
  }

  .signoff {
    margin-top: 6px;
    padding: 18px 22px 18px 26px;
    border-left: 2px solid var(--accent);
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
    background: var(--card-bg);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.4rem);
    line-height: 1.4;
    color: var(--fg);
  }

  /* ─── Tools ─── */
  .tools {
    padding: clamp(20px, 3vw, 32px);
  }

  .tiers {
    display: grid;
    gap: 22px;
    margin-top: 20px;
  }

  .tier {
    display: grid;
    gap: 10px;
  }

  .tier dt {
    display: flex;
    align-items: center;
    gap: 0.8em;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }

  .tier dt::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .tier dd {
    margin: 0;
  }

  /* Daily is lit, Comfortable is solid, Can read is a dashed outline */
  .tier[data-level='0'] .h-tag {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--fg);
  }

  .tier[data-level='1'] .h-tag {
    color: var(--fg);
  }

  .tier[data-level='2'] .h-tag {
    border-style: dashed;
    border-color: var(--line-strong);
    color: var(--fg-subtle);
  }

  /* ─── Working with me ─── */
  .habits {
    display: grid;
    gap: 18px;
    margin-top: clamp(44px, 6vw, 80px);
  }

  .habit-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    list-style: none;
    padding: 0;
  }

  @media (min-width: 640px) {
    .habit-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .habit-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .habit {
    display: grid;
    gap: 16px;
    align-content: start;
    padding: clamp(18px, 2.4vw, 26px);
  }

  .n {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent-text);
  }

  .habit p {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
</style>

---
// Interactive terminal for the 404 page. The command logic lives in lib/shell.js;
// this file builds the site map it browses and wires the input to the DOM.
import { projects } from '../data/projects.js';
import { about, experience, oss, misc } from '../data/profile.js';
import { site, socials, mastodon } from '../data/site.js';
import { getPosts, readingTime } from '../lib/writing.js';
import { STATUS, formatDate } from '../lib/format.js';

const year = String(new Date().getFullYear());
const words = (lines) => lines.join(' ').split(/\s+/).filter(Boolean).length;
const plain = (t) => t.replace(/\*\*/g, '');

const fs = {};

function dir(path, url, children) {
  fs[path] = {
    type: 'dir',
    url,
    children,
    meta: [
      ['Type', 'directory'],
      ['Entries', String(children.length)],
    ],
    size: 4096,
    year,
  };
}

function page(path, url, lines, meta) {
  fs[path] = { type: 'page', url, text: lines, meta, size: lines.join('\n').length, year };
}

const posts = await getPosts();

dir('/', '/', ['about', 'contact', 'experience', 'misc', 'open-source', 'projects', 'writing']);

const aboutLines = about.flatMap((p, i) => (i ? ['', p] : [p]));
page('/about', '/#about', aboutLines, [
  ['Type', 'page'],
  ['Words', String(words(aboutLines))],
]);

page(
  '/experience',
  '/#experience',
  experience.map((job) => `${job.period.padEnd(Math.max(...experience.map((j) => j.period.length)))}  ${job.role}, ${job.company}`),
  [
    ['Type', 'page'],
    ['Roles', String(experience.length)],
  ]
);

page(
  '/open-source',
  '/#oss',
  oss.flatMap((c, i) => [...(i ? [''] : []), `${c.org} (${c.lang}, ${c.period})`, ...c.bullets.map((b) => `  - ${plain(b)}`)]),
  [
    ['Type', 'page'],
    ['Projects', String(oss.length)],
  ]
);

page('/misc', '/#misc', misc.map((m) => `${m.title}  (${m.org})`), [
  ['Type', 'page'],
  ['Items', String(misc.length)],
]);

const contactRows = [['Email', site.email], ...socials.map((s) => [s.label, s.href]), ['Mastodon', mastodon]];
const contactWidth = Math.max(...contactRows.map(([k]) => k.length));
page(
  '/contact',
  '/#contact',
  contactRows.map(([k, v]) => `${k.padEnd(contactWidth)}  ${v}`),
  [['Type', 'page']]
);

dir('/projects', '/projects/', projects.map((p) => p.slug));
for (const p of projects) {
  const status = STATUS[p.status];
  const repoPath = new URL(p.repo).pathname.slice(1);
  const statWidth = Math.max(0, ...(p.stats ?? []).map((s) => s.value.length)) + 2;
  page(
    `/projects/${p.slug}`,
    `/projects/${p.slug}/`,
    [
      `${p.title} (${status.label.toLowerCase()}, ${p.year})`,
      p.summary,
      ...(p.stats ? ['', ...p.stats.map((s) => `${s.value.padEnd(statWidth)}${s.label}`)] : []),
      ...(p.limits ? ['', `Rough edge: ${p.limits[0]}`] : []),
      '',
      `Source: ${repoPath}`,
    ],
    [
      ['Type', 'project'],
      ['Status', `${status.glyph} ${status.label}`],
      ['Year', p.year],
      ['Stack', p.stack.join(' · ')],
      ['Source', repoPath],
    ]
  );
}

dir('/writing', '/writing/', posts.map((post) => post.id));
for (const post of posts) {
  page(
    `/writing/${post.id}`,
    `/writing/${post.id}/`,
    [post.data.title, post.data.description, '', `${formatDate(post.data.date)}${post.data.tags.length ? ` · ${post.data.tags.join(', ')}` : ''}`],
    [
      ['Type', 'post'],
      ['Date', formatDate(post.data.date)],
      ['Tags', post.data.tags.join(', ') || '-'],
      ['Read', `${readingTime(post.body)} min`],
    ]
  );
}

// "<" is escaped so no text in the data can close the script tag early
const data = JSON.stringify(fs).replace(/</g, '\\u003c');
---

<div class="term" data-term>
  <div class="out" data-out role="log" aria-live="polite" aria-label="Terminal output">
    <p class="line"><span class="prompt">$</span> cd <span data-path>/missing</span></p>
    <p class="line">cd: <span data-path>/missing</span>: No such file or directory</p>
    <p class="line" data-static><span class="prompt">$</span> <span class="cursor"></span></p>
  </div>
  <form class="row" data-row hidden>
    <span class="prompt" data-prompt aria-hidden="true">~ $</span>
    <input
      class="input"
      name="command"
      type="text"
      placeholder="type help"
      aria-label="Terminal command"
      autocomplete="off"
      autocapitalize="off"
      autocorrect="off"
      spellcheck="false"
      enterkeyhint="go"
    />
  </form>
</div>

<p class="meta hint" data-hint hidden>
  Click the terminal and type, or run <button type="button" data-run="help">help</button>,
  <button type="button" data-run="ls">ls</button> or <button type="button" data-run="tree">tree</button>.
</p>

<script id="term-fs" type="application/json" set:html={data} />

<script>
  import { createShell, nearestDir, suggestPath } from '../lib/shell.js';

  const term = document.querySelector('[data-term]');
  const out = term.querySelector('[data-out]');
  const row = term.querySelector('[data-row]');
  const input = row.querySelector('input');
  const prompt = row.querySelector('[data-prompt]');
  const hint = document.querySelector('[data-hint]');

  const fs = JSON.parse(document.getElementById('term-fs').textContent);
  const path = location.pathname;
  document.querySelectorAll('[data-path]').forEach((el) => (el.textContent = path));

  const shell = createShell(fs, { cwd: nearestDir(fs, path) });
  const promptText = `${shell.promptPath()} $`;

  // Output is built from text nodes only, never HTML
  function print(line) {
    const p = document.createElement('p');
    p.className = 'line';
    for (const seg of [].concat(line)) {
      if (typeof seg === 'string') {
        p.append(seg);
        continue;
      }
      const el = document.createElement(seg.href ? 'a' : 'span');
      el.textContent = seg.text;
      if (seg.href) el.href = seg.href;
      if (seg.cls) el.className = seg.cls;
      p.append(el);
    }
    if (!p.childNodes.length) p.textContent = ' ';
    out.append(p);
  }

  const echo = (value) => print([{ text: promptText, cls: 'prompt' }, ` ${value}`]);
  const scrollDown = () => (out.scrollTop = out.scrollHeight);

  let leaving = false;
  function navigate(url) {
    if (!url.startsWith('/')) return;
    leaving = true;
    input.disabled = true;
    setTimeout(() => location.assign(url), 350);
  }

  // A page restored from the back/forward cache comes back with the terminal frozen
  addEventListener('pageshow', (event) => {
    if (event.persisted && leaving) {
      leaving = false;
      input.disabled = false;
    }
  });

  let cursor = 0;
  let draft = '';

  function exec(value) {
    echo(value);
    const result = shell.run(value);
    if (result.clear) out.replaceChildren();
    result.lines.forEach(print);
    cursor = shell.history.length;
    draft = '';
    scrollDown();
    if (result.go) navigate(result.go);
  }

  function recall(step) {
    const past = shell.history;
    if (!past.length) return;
    if (cursor === past.length && step < 0) draft = input.value;
    cursor = Math.min(past.length, Math.max(0, cursor + step));
    input.value = cursor === past.length ? draft : past[cursor];
    requestAnimationFrame(() => input.setSelectionRange(input.value.length, input.value.length));
  }

  row.addEventListener('submit', (event) => {
    event.preventDefault();
    if (leaving) return;
    const value = input.value;
    input.value = '';
    exec(value);
  });

  input.addEventListener('keydown', (event) => {
    if (event.isComposing) return;
    const ctrl = event.ctrlKey && !event.metaKey && !event.altKey;

    if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
      event.preventDefault();
      recall(event.key === 'ArrowUp' ? -1 : 1);
    } else if (event.key === 'Tab' && !event.shiftKey && !event.ctrlKey && !event.altKey && !event.metaKey) {
      // An empty line lets Tab move focus on, so the terminal never traps keyboard users
      if (!input.value.trim()) return;
      const { line, options } = shell.complete(input.value);
      if (line === input.value && !options.length) return;
      event.preventDefault();
      if (options.length && line === input.value) {
        echo(input.value);
        print(options.join('  '));
        scrollDown();
      }
      input.value = line;
    } else if (ctrl && event.key.toLowerCase() === 'l') {
      event.preventDefault();
      out.replaceChildren();
    } else if (ctrl && event.key.toLowerCase() === 'u') {
      event.preventDefault();
      input.value = '';
    } else if (ctrl && event.key.toLowerCase() === 'c' && input.selectionStart === input.selectionEnd) {
      event.preventDefault();
      echo(`${input.value}^C`);
      input.value = '';
      scrollDown();
    }
  });

  // Run a command from the hint buttons
  document.addEventListener('click', (event) => {
    const button = event.target.closest('[data-run]');
    if (!button || leaving) return;
    exec(button.dataset.run);
    input.focus({ preventScroll: true });
  });

  // Clicking empty space in the terminal focuses the prompt, unless the visitor is selecting text
  term.addEventListener('click', (event) => {
    if (event.target.closest('a, button') || String(getSelection()).length) return;
    input.focus({ preventScroll: true });
  });

  // Typing anywhere on the page starts typing in the terminal, without stealing focus on load
  document.addEventListener('keydown', (event) => {
    const free = document.activeElement === document.body;
    const printable = event.key.length === 1 && !event.ctrlKey && !event.metaKey && !event.altKey;
    if (free && printable && !input.disabled) input.focus({ preventScroll: true });
  });

  // Upgrade the static transcript into a live prompt
  term.querySelector('[data-static]').remove();
  prompt.textContent = promptText;
  row.hidden = false;
  hint.hidden = false;

  const guess = suggestPath(fs, path);
  if (guess) print(['Did you mean ', { text: guess, href: fs[guess].url }, '?']);
</script>

<style>
  .term {
    max-width: 52rem;
    padding-bottom: var(--s-4);
    border: 1px solid var(--line);
    background: var(--bg-raised);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.8;
  }

  /* Phones zoom into inputs below 16px, so the whole terminal grows with the keyboard */
  @media (pointer: coarse) {
    .term {
      font-size: 1rem;
    }
  }

  .out {
    max-height: min(26rem, 55dvh);
    overflow-y: auto;
    padding: var(--s-4) var(--s-5) 0;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
  }

  /* Lines are added by script, so they sit outside Astro's scoped styles */
  .out :global(.line) {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .out :global(a) {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: var(--line-strong);
  }

  .out :global(a:hover) {
    text-decoration-color: currentColor;
  }

  .out :global(.dir) {
    font-weight: 600;
  }

  .out :global(.prompt),
  .prompt {
    color: var(--fg);
  }

  .row {
    display: flex;
    align-items: baseline;
    gap: 0.75ch;
    padding-inline: var(--s-5);
  }

  .prompt {
    flex: none;
    white-space: pre;
  }

  .input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--fg);
    font: inherit;
    caret-color: var(--fg);
  }

  .input::placeholder {
    color: var(--fg-subtle);
    opacity: 1;
  }

  /* The whole terminal shows focus, since the input has no box of its own */
  @supports selector(:has(*)) {
    .input:focus-visible {
      outline: none;
    }

    .term:has(.input:focus-visible) {
      outline: 2px solid var(--fg);
      outline-offset: 3px;
    }
  }

  .hint {
    margin-top: calc(var(--s-3) * -1);
  }

  .hint button {
    padding: 0 2px;
    color: var(--fg);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: var(--line-strong);
  }

  .hint button:hover {
    text-decoration-color: currentColor;
  }
</style>

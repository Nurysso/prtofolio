---
import BaseLayout from '../layouts/BaseLayout.astro';
import Terminal from '../components/Terminal.astro';
---

<BaseLayout title="404 · Not found" description="This page doesn't exist." noindex>
  <section class="container nf" aria-labelledby="nf-title">
    <p class="label">Error</p>
    <h1 id="nf-title" class="code">404</h1>
    <Terminal />
    <div class="ctas">
      <a class="btn btn-primary" href="/">cd ~ <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn-secondary" href="/projects/">cd projects/</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    align-content: center;
    gap: var(--s-5);
    min-height: calc(100dvh - var(--nav-h) - 120px);
    padding-block: var(--section-y);
  }

  .code {
    font-family: var(--font-mono);
    font-size: clamp(6rem, 3rem + 16vw, 14rem);
    font-weight: 500;
    line-height: 0.85;
    letter-spacing: -0.06em;
  }

  .ctas {
    margin-top: var(--s-3);
  }
</style>

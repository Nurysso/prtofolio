---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { projects } from '../../data/projects.js';
import { STATUS, pad } from '../../lib/format.js';

export function getStaticPaths() {
  const n = projects.length;
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, prev: projects[(i - 1 + n) % n], next: projects[(i + 1) % n] },
  }));
}

const { project: p, prev, next } = Astro.props;
const status = STATUS[p.status];
const repoPath = new URL(p.repo).pathname.slice(1);

const facts = [
  ['Status', `${status.glyph} ${status.label}`],
  ['Year', p.year],
  ['Stack', p.stack.join(' · ')],
  ['Source', repoPath],
];

// Section numbers follow whichever blocks this project actually has
const blocks = [
  { kind: 'overview', id: 'overview', label: 'Overview', title: 'What it does' },
  p.usage && { kind: 'usage', id: 'usage', label: 'Usage', title: p.usage.title },
  ...(p.sections ?? []).map((s, i) => ({ kind: 'items', id: `section-${i + 1}`, ...s })),
  p.install && { kind: 'install', id: 'install', label: 'Install', title: 'Get it running' },
  p.limits && { kind: 'limits', id: 'limits', label: 'Limits', title: 'Rough edges' },
  p.faq && { kind: 'faq', id: 'faq', label: 'FAQ', title: 'Before you try it' },
].filter(Boolean);
---

<BaseLayout
  title={p.seo?.title ?? `${p.title} · ${p.stack.join(' · ')} · Dawood Khan (Nurysso)`}
  description={p.seo?.description ?? p.summary}
  current="work"
>
  <header class="head">
    <div class="container">
      <nav class="meta crumbs" aria-label="Breadcrumb">
        <a class="link" href="/">~</a> / <a class="link" href="/#work">projects</a> / <span aria-current="page">{p.slug}</span>
      </nav>

      <h1 class="title">{p.title}</h1>
      <p class="lede">{p.summary}</p>

      <div class="ctas">
        {
          p.install && (
            <a class="btn btn-primary" href="#install">
              Install <span class="arrow" aria-hidden="true">↓</span>
            </a>
          )
        }
        <a
          class={p.install ? 'btn btn-secondary' : 'btn btn-primary'}
          href={p.repo}
          target="_blank"
          rel="noopener noreferrer"
        >
          View source <span class="arrow" aria-hidden="true">↗</span>
        </a>
        {
          p.site && (
            <a class="btn btn-secondary" href={p.site} target="_blank" rel="noopener noreferrer">
              Website <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>

      <dl class="ruled facts">
        {
          facts.map(([key, value]) => (
            <div>
              <dt class="label">{key}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>

      {
        p.stats && (
          <dl class="ruled pstats">
            {p.stats.map((s) => (
              <div>
                <dd class="pvalue">{s.value}</dd>
                <dt class="meta">{s.label}</dt>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </header>

  {
    blocks.map((block, i) => (
      <Section id={block.id} index={pad(i + 1)} label={block.label} title={block.title}>
        {block.kind === 'overview' && <p class="overview">{p.description ?? p.summary}</p>}
        {block.kind === 'usage' && (
          <div class="install">
            {p.usage.steps.map((step) => (
              <CodeBlock label={step.label} code={step.code} prompt={step.prompt} />
            ))}
          </div>
        )}
        {block.kind === 'faq' && (
          <dl class="ruled faq">
            {p.faq.map((item) => (
              <div>
                <dt class="h3">{item.q}</dt>
                <dd>{item.a}</dd>
              </div>
            ))}
          </dl>
        )}
        {block.kind === 'install' && (
          <div class="install">
            {p.install.map((step) => (
              <CodeBlock label={step.label} code={step.cmd} />
            ))}
            {p.installNote && <p class="meta">{p.installNote}</p>}
          </div>
        )}
        {block.kind === 'limits' && (
          <ul class="bullets limits">
            {p.limits.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        )}
        {block.kind === 'items' && (
          <ul class="ruled items">
            {block.items.map((item) => (
              <li>
                <h3 class="h3">{item.title}</h3>
                <p>{item.desc}</p>
              </li>
            ))}
          </ul>
        )}
      </Section>
    ))
  }

  <section class="cta container" aria-labelledby="cta-title">
    <h2 id="cta-title" class="cta-title">{p.title}</h2>
    <p class="lede">{p.summary}</p>
    <div class="ctas">
      {
        p.install && (
          <a class="btn btn-primary" href="#install">
            Install <span class="arrow" aria-hidden="true">↑</span>
          </a>
        )
      }
      <a
        class={p.install ? 'btn btn-secondary' : 'btn btn-primary'}
        href={p.repo}
        target="_blank"
        rel="noopener noreferrer"
      >
        Star on GitHub <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <nav class="pager container" aria-label="More projects">
    <a href={`/projects/${prev.slug}/`} class="pager-link">
      <span class="label">← Previous</span>
      <span class="h3">{prev.title}</span>
    </a>
    <a href={`/projects/${next.slug}/`} class="pager-link next">
      <span class="label">Next →</span>
      <span class="h3">{next.title}</span>
    </a>
  </nav>
</BaseLayout>

<style>
  .head {
    padding-block: clamp(40px, 7vw, 88px) clamp(56px, 8vw, 104px);
  }

  .crumbs {
    margin-bottom: clamp(32px, 6vw, 64px);
  }

  .crumbs span {
    color: var(--fg);
  }

  .title {
    font-size: clamp(3rem, 1.6rem + 6vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .lede {
    margin-top: var(--s-5);
  }

  .ctas {
    margin-top: var(--s-6);
  }

  .facts {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: clamp(40px, 6vw, 72px);
  }

  @media (min-width: 960px) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .facts > div {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding: var(--s-4) clamp(16px, 2vw, 24px);
  }

  .facts dd {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }

  .pstats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 960px) {
    .pstats {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    }
  }

  .pstats > div {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: clamp(16px, 2.5vw, 28px);
  }

  .pvalue {
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .faq > div {
    display: grid;
    gap: var(--s-2);
    padding: clamp(20px, 3vw, 28px);
  }

  .faq dd {
    max-width: 62ch;
    color: var(--fg-muted);
    font-size: 0.9375rem;
  }

  .cta {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    padding-block: clamp(48px, 8vw, 96px);
    border-top: 1px solid var(--line);
  }

  .cta-title {
    font-size: clamp(2rem, 1.2rem + 3vw, 3.5rem);
    letter-spacing: -0.04em;
  }

  .overview {
    max-width: 62ch;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.55;
    color: var(--fg-muted);
  }

  .install {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-4);
  }

  .limits {
    max-width: 62ch;
    gap: var(--s-4);
  }

  .items {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 640px) {
    .items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* An odd item out spans the row so no empty cell is left */
    .items > li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  .items li {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding: clamp(20px, 3vw, 28px);
  }

  .items p {
    color: var(--fg-muted);
    font-size: 0.9375rem;
  }

  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  .pager-link {
    display: grid;
    gap: var(--s-2);
    padding-block: var(--s-7);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .pager-link .h3 {
    color: var(--fg-muted);
    transition: color var(--dur) var(--ease);
  }

  .pager-link:hover .h3 {
    color: var(--fg);
  }

  .next {
    text-align: right;
    border-left: 1px solid var(--line);
  }
</style>

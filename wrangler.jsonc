{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prtofolio",
  "compatibility_date": "2026-07-23",
  // Static Astro build: Cloudflare serves dist/ directly, no Worker script needed
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
}
